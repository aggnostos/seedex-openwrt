#!/bin/sh

. /usr/lib/seedex/common.sh

SERVICES="router vpn proxy dns"

_field() {
	printf '%s' "$INPUT" | jq -r --arg k "$1" '.[$k] // "" | tostring'
}

_error() {
	jq -n --arg error "$1" '{code: 2, output: "", error: $error}'
	exit 0
}

_run() {
	local err out rc
	err=$(mktemp)
	if [ -n "$STDIN" ]; then
		out=$(printf '%s\n' "$STDIN" | sdx "$@" 2>"$err")
	else
		out=$(sdx "$@" 2>"$err" </dev/null)
	fi
	rc=$?
	jq -n --argjson code "$rc" --arg output "$out" --rawfile error "$err" \
		'{code: $code, output: $output, error: ($error | rtrimstr("\n"))}'
	rm -f "$err"
}

_pending() {
	local svc
	for svc in $SERVICES; do
		uci changes "seedex-$svc" 2>/dev/null |
			jq -R -s --arg svc "$svc" '{($svc): (split("\n") | map(select(length > 0)))}'
	done | jq -s 'add // {}'
}

_flags() {
	local svc
	for svc in $SERVICES; do
		printf '%s %s %s\n' "$svc" "$(seedex_service_up "$svc" && echo true || echo false)" \
			"$(seedex_config_stale "$svc" && echo true || echo false)"
	done | jq -R -s 'split("\n") | map(select(length > 0) | split(" "))
		| { running: (map({key: .[0], value: (.[1] == "true")}) | from_entries),
		    stale: (map({key: .[0], value: (.[2] == "true")}) | from_entries) }'
}

do_status() {
	jq -n --arg text "$(sdx 2>&1)" --argjson flags "$(_flags)" --argjson pending "$(_pending)" \
		'$flags + {text: $text, pending: $pending}'
}

do_config() {
	local svc
	svc=$(_field svc)
	case "$svc" in
	vpn | proxy | router | dns) ;;
	*) _error "unknown service: $svc" ;;
	esac
	ubus call uci get "{\"config\":\"seedex-$svc\"}" 2>/dev/null || echo '{"values":{}}'
}

do_run() {
	local svc action
	svc=$(_field svc)
	action=$(_field action)
	STDIN=$(_field stdin)

	case "$svc" in
	"" | vpn | proxy | router | dns) ;;
	*) _error "unknown service: $svc" ;;
	esac
	case "$action" in
	"" | *[!a-z_-]*) _error "invalid action" ;;
	esac

	if [ -n "$svc" ]; then
		_run "$svc" "$action" "$@"
	else
		_run "$action" "$@"
	fi
}

_file_name() {
	local base="$1" ext=""
	case "$base" in
	?*.*)
		ext=$(printf '%s' "${base##*.}" | tr -cd 'A-Za-z0-9')
		base="${base%.*}"
		;;
	esac
	base=$(printf '%s' "$base" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^[-.]*//; s/-*$//; s/--*/-/g')
	printf '%s%s\n' "${base:-config}" "${ext:+.$ext}"
}

do_import() {
	local name dir
	name=$(_file_name "$(_field name)")

	dir=$(mktemp -d)
	chmod 700 "$dir"
	printf '%s' "$INPUT" | jq -r '.content // ""' >"$dir/$name"
	[ -s "$dir/$name" ] || {
		rm -rf "$dir"
		_error "content required"
	}
	_run import "$dir/$name"
	rm -rf "$dir"
}

do_file() {
	local svc path dir source missing=false
	svc=$(_field svc)
	path=$(_field path)
	case "$svc" in
	vpn) dir="$SEEDEX_VPN_DIR" ;;
	proxy) dir="$SEEDEX_PROXY_DIR" ;;
	*) _error "unknown service: $svc" ;;
	esac
	case "$path" in
	"$dir"/*) ;;
	*) _error "path is outside $dir" ;;
	esac
	case "${path#"$dir"/}" in
	*/* | .*) _error "invalid path" ;;
	esac

	source="$path"
	[ -f "$path" ] || {
		missing=true
		source=/dev/null
	}
	jq -n --arg path "$path" --argjson missing "$missing" --rawfile content "$source" \
		'{path: $path, missing: $missing, content: $content}'
}

_link_row() {
	local n="$1" url ts state when="never synced" ok=false n_vpn n_proxy selected
	url=$(uci -q get "seedex-link.$n.url")
	selected=$(uci -q get "seedex-link.$n.config")
	if [ -f "$LINK_RUNDIR/$n" ]; then
		read -r ts state <"$LINK_RUNDIR/$n"
		when="$((($(date +%s) - ts) / 60)) min ago"
		case "$state" in
		synced) ok=true ;;
		"synced "*) when="$when, ${state#synced } selected missing" ;;
		error:*) when="$when, ${state#error: }" ;;
		esac
	fi
	n_vpn=$(uci -q show seedex-vpn | grep -c "\.link='$n'")
	n_proxy=$(uci -q show seedex-proxy | grep -c "\.link='$n'")
	jq -n --arg name "$n" --arg url "$url" --arg when "$when" --argjson ok "$ok" \
		--argjson vpn "$n_vpn" --argjson proxy "$n_proxy" --arg selected "$selected" \
		'{name: $name, url: $url, ok: $ok, when: $when, vpn: $vpn, proxy: $proxy,
		  selected: ($selected | split(" ") | map(select(length > 0)))}'
}

do_link() {
	local n
	. /usr/lib/seedex/link.sh
	for n in $(_link_names); do
		_link_row "$n"
	done | jq -s '{links: .}'
}

do_link_configs() {
	local name tmp payload err svc ext f c imported
	name=$(_field name)
	. /usr/lib/seedex/link.sh
	case "$name" in
	"" | *[!A-Za-z0-9._-]* | -*) _error "invalid link name" ;;
	esac
	uci -q get "seedex-link.$name" >/dev/null 2>&1 || _error "link '$name' not found"
	tmp=$(mktemp -d)
	payload="$tmp/configs.json"
	if ! err=$(_link_fetch "$name" "$payload"); then
		rm -rf "$tmp"
		_error "$err"
	fi
	_link_unpack "$payload" "$tmp"
	for svc in vpn proxy; do
		case "$svc" in
		vpn) ext=conf ;;
		*) ext=json ;;
		esac
		for f in "$tmp/$svc"/*."$ext"; do
			[ -f "$f" ] || continue
			c="${f##*/}"
			c="${c%.*}"
			imported=false
			[ "$(_owner_of "$svc" "$c")" = "$name" ] && imported=true
			printf '%s %s %s\n' "$svc" "$c" "$imported"
		done
	done | jq -R -s --arg selected "$(_link_selected "$name")" 'split("\n") | map(select(length > 0) | split(" "))
		| { vpn: map(select(.[0] == "vpn") | {name: .[1], imported: (.[2] == "true")}),
		    proxy: map(select(.[0] == "proxy") | {name: .[1], imported: (.[2] == "true")}),
		    selected: ($selected | split(" ") | map(select(length > 0))) }'
	rm -rf "$tmp"
}

do_logs() {
	local svc
	svc=$(_field svc)
	case "$svc" in
	"") _run logs ;;
	vpn | proxy | router | dns) _run logs -e "seedex-$svc" ;;
	*) _error "unknown service: $svc" ;;
	esac
}

METHOD="${2:-}"
case "$1" in
list)
	cat <<'JSON'
{
  "status": {},
  "config": { "svc": "str" },
  "run": { "svc": "str", "action": "str", "args": [ "str" ], "stdin": "str" },
  "import": { "name": "str", "content": "str" },
  "file": { "svc": "str", "path": "str" },
  "logs": { "svc": "str" },
  "link": {},
  "link_configs": { "name": "str" }
}
JSON
	;;
call)
	INPUT=$(cat)
	STDIN=""
	eval "set -- $(printf '%s' "$INPUT" | jq -r '(.args // []) | map(tostring | @sh) | join(" ")')"
	case "$METHOD" in
	status) do_status ;;
	config) do_config ;;
	run) do_run "$@" ;;
	import) do_import ;;
	file) do_file ;;
	logs) do_logs ;;
	link) do_link ;;
	link_configs) do_link_configs ;;
	*) exit 1 ;;
	esac
	;;
esac
