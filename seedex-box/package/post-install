#!/bin/sh

set -e

[ -z "${IPKG_INSTROOT:-}" ] || exit 0

mkdir -p /etc/seedex/vpn /etc/seedex/proxy
chmod 700 /etc/seedex/vpn /etc/seedex/proxy

if [ -x /etc/init.d/https-dns-proxy ]; then
	/etc/init.d/https-dns-proxy disable >/dev/null 2>&1 || true
	/etc/init.d/https-dns-proxy stop >/dev/null 2>&1 || true
fi

grep -q 'sdx link sync' /etc/crontabs/root 2>/dev/null || {
	mkdir -p /etc/crontabs
	echo '*/30 * * * * /usr/bin/sdx link sync >/dev/null 2>&1' >>/etc/crontabs/root
	/etc/init.d/cron restart 2>/dev/null || true
}

/etc/init.d/seedex enable 2>/dev/null || true

exit 0
