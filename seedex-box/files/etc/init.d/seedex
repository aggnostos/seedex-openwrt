#!/bin/sh /etc/rc.common

START=99
STOP=1

TAG="seedex"
. /usr/lib/seedex/common.sh

IFACE_TIMEOUT=30
PROXY_IFACES="$SEEDEX_RUNDIR/proxy/ifaces"

_ifaces_missing() {
	local registered
	registered=" $(seedex_all_ifaces | awk '{ print $1 }' | tr '\n' ' ')"
	[ "$registered" != " " ] || return 0
	[ -f "$PROXY_IFACES" ] || return 1
	awk -v r="$registered" '!index(r, " " $1 " ") { found = 1 } END { exit !found }' "$PROXY_IFACES"
}

_wait_for_ifaces() {
	local i=0
	while [ "$i" -lt "$IFACE_TIMEOUT" ]; do
		if ! _ifaces_missing; then
			log_info "interfaces ready ($(seedex_all_ifaces | wc -l | tr -d ' ') registered)"
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	log_warn "not every interface registered after ${IFACE_TIMEOUT}s, starting router anyway"
}

start() {
	log_info "starting"
	mkdir -p "$SEEDEX_RUNDIR"

	local svc
	export SEEDEX_BOOT=1
	for svc in seedex-dns seedex-vpn seedex-proxy; do
		seedex_service_enabled "${svc#seedex-}" || continue
		[ -x "/etc/init.d/$svc" ] && /etc/init.d/$svc start
	done

	if seedex_service_enabled vpn || seedex_service_enabled proxy; then
		_wait_for_ifaces
	fi

	if seedex_service_enabled router && ! seedex_service_registered router; then
		/etc/init.d/seedex-router start
	fi

	log_info "started"
}

stop() {
	log_info "stopping"

	local svc
	for svc in seedex-router seedex-proxy seedex-vpn seedex-dns; do
		/etc/init.d/$svc stop 2>/dev/null
	done

	rm -rf "$SEEDEX_IFACE_DIR"
	log_info "stopped"
}

restart() {
	stop
	start
}
