#!/bin/sh /etc/rc.common

USE_PROCD=1

TAG="seedex-vpn"
. /usr/lib/seedex/common.sh
. /lib/functions.sh
seedex_vpn_load

RUNDIR="$SEEDEX_RUNDIR/vpn"

NFT_TABLE="seedex_vpn"

setup_interface() {
	local section="$1"
	local enabled config name proto interface

	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get config "$section" config ''
	config_get name "$section" name "$section"
	config_get proto "$section" proto ''

	[ -n "$config" ] || {
		log_err "config '$name': missing config path"
		return 1
	}
	[ -f "$config" ] || {
		log_err "config '$name': '$config' not found"
		return 1
	}
	[ -n "$proto" ] || proto=$(seedex_vpn_detect "$config") || {
		log_err "config '$name': not a known VPN config"
		return 1
	}
	case " $SEEDEX_VPN_PROTOCOLS " in
	*" $proto "*) ;;
	*)
		log_err "config '$name': no module for protocol '$proto'"
		return 1
		;;
	esac

	local n
	eval "n=\${IFACE_N_$proto:-0}"
	interface="$proto$n"
	eval "IFACE_N_$proto=$((n + 1))"

	"vpn_${proto}_up" "$interface" "$config" "$name" || return 1

	echo "$interface $proto" >>"$RUNDIR/active_ifaces"
	seedex_register_iface "$interface" "vpn" "$name"
}

teardown_interfaces() {
	local interface proto
	[ -f "$RUNDIR/active_ifaces" ] || return 0
	while read -r interface proto; do
		[ -n "$interface" ] || continue
		seedex_unregister_iface "$interface"
		"vpn_${proto:-wg}_down" "$interface"
		log_debug "$interface down"
	done <"$RUNDIR/active_ifaces"
}

_print_active_interfaces() {
	[ -f "$RUNDIR/active_ifaces" ] || return 0
	awk '{ print $1 }' "$RUNDIR/active_ifaces"
}

service_triggers() {
	procd_add_reload_trigger seedex-vpn
}

start_service() {
	config_load seedex-vpn
	seedex_config_stamp vpn
	seedex_prune_configs seedex-vpn config "$SEEDEX_VPN_DIR"

	if [ -s "$RUNDIR/active_ifaces" ]; then
		# shellcheck disable=SC2046
		seedex_nat_disable "$NFT_TABLE" $(_print_active_interfaces)
		teardown_interfaces
	fi

	mkdir -p "$RUNDIR"
	rm -f "$RUNDIR/active_ifaces"
	config_foreach setup_interface config

	if [ ! -s "$RUNDIR/active_ifaces" ]; then
		log_err "no interfaces started"
		return 1
	fi

	local ifaces count
	ifaces=$(_print_active_interfaces | tr '\n' ' ')
	ifaces="${ifaces% }"
	count=$(echo "$ifaces" | wc -w | tr -d ' ')

	# shellcheck disable=SC2086
	seedex_nat_enable "$NFT_TABLE" $ifaces

	log_info "started ($count interface(s): $ifaces)"
	seedex_start_router
}

stop_service() {
	# shellcheck disable=SC2046
	seedex_nat_disable "$NFT_TABLE" $(_print_active_interfaces)
	teardown_interfaces
	rm -rf "$RUNDIR"
	log_info "stopped"
}
