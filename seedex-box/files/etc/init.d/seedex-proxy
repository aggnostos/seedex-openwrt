#!/bin/sh /etc/rc.common

USE_PROCD=1

TAG="seedex-proxy"
. /usr/lib/seedex/common.sh
. /lib/functions.sh

PROXY_RUNDIR="$SEEDEX_RUNDIR/proxy"
CONFIG_FILE="$PROXY_RUNDIR/config.json"
IFACE_MAP="$PROXY_RUNDIR/ifaces"

NFT_TABLE="seedex_proxy"

SING_BOX_EXEC=/usr/bin/sing-box

PID_FILE="$PROXY_RUNDIR/sing-box.pid"

EXTRA_COMMANDS="attach detach"

_load_config() {
	config_load seedex-proxy
	config_get LOG_LEVEL main log_level 'warn'
	config_get URLTEST_INTERVAL main urltest_interval '1m'
}

_ifaces() {
	awk '{ print $1 }' "$IFACE_MAP" 2>/dev/null
}

_name_of() {
	awk -v d="$1" '$1 == d { print $2; exit }' "$IFACE_MAP" 2>/dev/null
}

_sync_nat() {
	local iface live="" dead=""
	for iface in $(_ifaces); do
		if seedex_iface_is_up "$iface"; then
			live="$live $iface"
		else
			dead="$dead $iface"
		fi
	done
	# shellcheck disable=SC2086
	[ -z "$dead" ] || seedex_fw_forget $dead
	# shellcheck disable=SC2086
	[ -z "$live" ] || seedex_nat_enable "$NFT_TABLE" $live
}

_attach() {
	local dev="$1" name
	name=$(_name_of "$dev")
	[ -n "$name" ] || return 0
	seedex_register_iface "$dev" "proxy" "$name"
	_sync_nat
	log_info "config '$name' up on $dev"
}

_detach() {
	local dev="$1" iface
	if [ -n "$dev" ]; then
		seedex_unregister_iface "$dev"
		_sync_nat
		return 0
	fi
	for iface in $(_ifaces); do
		seedex_unregister_iface "$iface"
	done
	# shellcheck disable=SC2046,SC2086
	seedex_nat_disable "$NFT_TABLE" $(_ifaces)
}

_collect_enabled() {
	ENABLED_CONFIGS=""
	ENABLED_NAMES=""

	_collect_one() {
		local section="$1" enabled config name
		config_get_bool enabled "$section" enabled 0
		[ "$enabled" -eq 1 ] || return 0

		config_get config "$section" config ''
		config_get name "$section" name "$section"
		[ -n "$config" ] || return 0
		[ -f "$config" ] || {
			log_warn "config '$name': '$config' not found, skipping"
			return 0
		}
		ENABLED_CONFIGS="$ENABLED_CONFIGS $config"
		ENABLED_NAMES="$ENABLED_NAMES $name"
	}

	config_foreach _collect_one config
	ENABLED_CONFIGS="${ENABLED_CONFIGS# }"
	ENABLED_NAMES="${ENABLED_NAMES# }"
}

_assemble_config() {
	mkdir -p "$(dirname "$CONFIG_FILE")"

	[ -n "$ENABLED_CONFIGS" ] || {
		log_err "no enabled proxy configs"
		return 1
	}

	local outbounds
	# shellcheck disable=SC2086
	outbounds=$(jq -s '
		[ .[] | [ .outbounds[]? | select(.tag != "direct") ] ]
		| to_entries
		| reduce .[] as $e ({ seen: [], out: [] };
		    . as $acc
		    | ( reduce ($e.value[] | .tag) as $t ({};
		          if ($acc.seen | index($t))
		          then . + { ($t): ($t + "-" + ($e.key | tostring)) }
		          else . end)
		      ) as $ren
		    | { seen: ($acc.seen + [ $e.value[] | .tag as $t | $ren[$t] // $t ]),
		        out:  ($acc.out  + [ $e.value[]
		                             | (.tag |= ($ren[.] // .))
		                             | (if has("detour")
		                                then (.detour |= ($ren[.] // .))
		                                else . end)
		                             | . + { _src: $e.key } ]) })
		| .out
	' $ENABLED_CONFIGS 2>/dev/null) || {
		log_err "could not read outbounds from: $ENABLED_CONFIGS"
		return 1
	}

	printf '%s' "$outbounds" | jq -r '.[] | "\(._src)"' | sort -un |
		awk -v prefix="$SEEDEX_PROXY_IFACE_PREFIX" -v names="$ENABLED_NAMES" \
			'BEGIN { split(names, n, " ") } { print prefix $1, n[$1 + 1] }' >"$IFACE_MAP"

	local server_cidrs
	server_cidrs=$(printf '%s' "$outbounds" |
		jq -r '.[] | .server? // empty' |
		grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' |
		sort -u |
		awk 'BEGIN { printf "[" } { printf "%s\"%s/32\"", sep, $0; sep = "," } END { printf "]" }')

	jq -n \
		--argjson outbounds "$outbounds" \
		--argjson cidrs "$server_cidrs" \
		--arg prefix "$SEEDEX_PROXY_IFACE_PREFIX" \
		--arg level "$LOG_LEVEL" \
		--arg interval "$URLTEST_INTERVAL" \
		--arg probe "$SEEDEX_PROBE_URL" '
		([ $outbounds[] | ._src ] | unique) as $srcs
		| [ $srcs[] as $s
		    | [ $outbounds[] | select(._src == $s) ] as $group
		    | [ $group[] | .detour // empty ] as $legs
		    | { n: ($s | tostring),
		        iface: ($prefix + ($s | tostring)),
		        tun: ("tun-" + ($s | tostring)),
		        entries: [ $group[] | select(.tag as $t | ($legs | index($t)) == null) | .tag ] } ]
		| map(. + { out: (if (.entries | length) > 1 then "auto-" + .n else .entries[0] end) }) as $groups
		| {
		    log: { level: $level, timestamp: true },
		    dns: {
		      servers: [ { type: "udp", tag: "local-dns", server: "127.0.0.1" } ],
		      final: "local-dns",
		      strategy: "prefer_ipv4"
		    },
		    inbounds: [ $groups[]
		      | { type: "tun", tag: .tun, interface_name: .iface,
		          address: [ "172.19." + .n + ".1/30", "fdfe:dcba:9876:" + .n + "::1/126" ],
		          auto_route: false, stack: "gvisor" } ],
		    outbounds: (
		      [ $outbounds[] | del(._src) ]
		      + [ $groups[] | select((.entries | length) > 1)
		          | { type: "urltest", tag: .out, outbounds: .entries, url: $probe, interval: $interval } ]
		      + [ { type: "direct", tag: "direct" } ]
		    ),
		    route: {
		      rules: (
		        [ { inbound: [ $groups[].tun ], action: "sniff" },
		          { protocol: "dns", action: "hijack-dns" },
		          { ip_is_private: true, outbound: "direct" },
		          { ip_cidr: $cidrs, outbound: "direct" } ]
		        + [ $groups[] | { inbound: [ .tun ], outbound: .out } ]
		      ),
		      final: "direct",
		      auto_detect_interface: true,
		      default_domain_resolver: "local-dns"
		    }
		  }' >"$CONFIG_FILE" || {
		log_err "config assembly failed"
		rm -f "$CONFIG_FILE"
		return 1
	}
	chmod 600 "$CONFIG_FILE"

	local check_err
	if ! check_err="$($SING_BOX_EXEC check -c "$CONFIG_FILE" 2>&1)"; then
		log_err "config validation failed: $check_err"
		rm -f "$CONFIG_FILE"
		return 1
	fi
	[ -n "$check_err" ] && log_warn "sing-box warnings: $check_err"

	log_debug "config assembled from: $ENABLED_CONFIGS"
}

service_triggers() {
	procd_add_reload_trigger seedex-proxy
}

start_service() {
	_load_config
	seedex_config_stamp proxy
	seedex_prune_configs seedex-proxy config "$SEEDEX_PROXY_DIR"
	_collect_enabled

	if ! _assemble_config; then
		log_err "setup failed, not starting"
		return 1
	fi

	procd_open_instance 'sing-box'
	procd_set_param command $SING_BOX_EXEC run -c "$CONFIG_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile "$PID_FILE"
	procd_set_param term_timeout 5
	procd_set_param file /etc/config/seedex-proxy
	local cfg
	for cfg in $ENABLED_CONFIGS; do
		procd_set_param file "$cfg"
	done
	procd_close_instance
	seedex_start_router
}

attach() {
	_load_config
	[ -f "$CONFIG_FILE" ] || return 0
	_attach "$1"
}

detach() {
	_load_config
	_detach "$1"
}

stop_service() {
	_load_config
	_detach ""
	rm -rf "$PROXY_RUNDIR"
	log_info "stopped"
}
